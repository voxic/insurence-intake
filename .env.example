# Server only. Never expose this in client code or NEXT_PUBLIC_* vars.
# The Next.js route /api/session mints a short-lived xAI ephemeral token
# and the browser connects to wss://api.x.ai/v1/realtime with that token.
# The same key lists voices (GET /api/voices) and synthesizes settings
# previews (GET /api/voices/preview). Published xAI sample URLs play without it.
XAI_API_KEY=

# Bearer token for MCP at /mcp, served by the Next process (min 24 characters).
# Without it /mcp answers 401. Required by the public demo process.
# Never prefix with NEXT_PUBLIC_ — the browser must not receive this value.
MCP_AUTH_TOKEN=

# Optional. Persistent transcript root for a single-instance host (Fly volume).
# Backoffice data is in memory and reseeded from data/backoffice/seed.json on boot.
# DATA_DIR=/data

# Optional guard for POST /api/session (which mints Realtime tokens with the real
# XAI_API_KEY). Leave UNSET to keep the route open. When set (min 16 chars),
# callers must send `Authorization: Bearer <token>` or `x-session-access-token`.
# Never prefix with NEXT_PUBLIC_.
# SESSION_ACCESS_TOKEN=

# Shared password for the browser demo on the public host (min 8 characters).
# POST /api/demo-login exchanges it for a site-wide (Path=/) HTTP-only cookie
# that lasts 8 hours. Required by `npm run start:public`; unset local dev stays open.
# Never prefix with NEXT_PUBLIC_.
# DEMO_PASSWORD=

# Optional lightweight per-client rate limit for POST /api/session (single
# instance only). Defaults to 10 requests per 60s. Set SESSION_RATE_LIMIT=0 to
# disable.
# SESSION_RATE_LIMIT=10
# SESSION_RATE_WINDOW_MS=60000
